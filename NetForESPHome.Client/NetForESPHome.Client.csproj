<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetForESPHome.Client</PackageId>
    <Authors>BartS</Authors>
    <Description>
      Idiomatic .NET client for the ESPHome Native API protocol.
      Supports ESPHome device discovery, plaintext and Noise-encrypted connections,
      entity state subscriptions, device information, Bluetooth proxy features,
      and other Native API functionality.
    </Description>

    <PackageTags>ESPHome;IoT;SmartHome;NativeAPI;ESP32</PackageTags>

    <RepositoryUrl>https://github.com/Bartsz/NetForESPHome/tree/dev</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Bartsz/NetForESPHome/tree/dev</PackageProjectUrl>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>.\README.md</PackageReadmeFile>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Version>0.1.0</Version>

    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage
    </TargetsForTfmSpecificBuildOutput>

  </PropertyGroup>

  <ItemGroup>
    <None Include=".\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Noise.NET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetForESPHome.DomainModel\NetForESPHome.DomainModel.csproj"  PrivateAssets="all" />
    <ProjectReference Include="..\NetForESPHome.Transport\NetForESPHome.Transports.csproj"  PrivateAssets="all" />
  </ItemGroup>
  
  <Target Name="CopyProjectReferencesToPackage"
          DependsOnTargets="BuildOnlySettings;ResolveReferences">

    <ItemGroup>
      <_ProjectReferenceOutputs
          Include="@(ReferenceCopyLocalPaths
          ->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')
          ->WithMetadataValue('PrivateAssets', 'All'))" />

      <BuildOutputInPackage Include="@(_ProjectReferenceOutputs)" />
    </ItemGroup>

  </Target>

</Project>